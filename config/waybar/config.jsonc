{
  "layer": "top",
  "position": "top",
  "mod": "dock",
  "margin-left": 0,
  "margin-right": 0,
  "margin-top": 0,
  "margin-bottom": 0,
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "reload_style_on_change": true,
  "modules-center": [
    "group/message",
    "group/window",
    "group/media",
    "group/date",
    "group/network",
    "group/sound",
    "group/system",
    "group/battery",
  ],

  "hyprland/window": {
    "format": "{}",
    "max-length": 0,
    "separate-outputs": true,
    "offscreen-css": true,
    "offscreen-css-text": "",
  },

  "custom/cava": {
    "exec": "~/.config/waybar/scripts/cava.sh",
    "return-type": "json",
    "restart-interval": 1,
  },

  "custom/margin": {
    "format": " ",
    "interval": "once",
    "tooltip": false,
  },

  "custom/separator": {
    "format": "-",
    "interval": "once",
    "tooltip": false,
  },

  "custom/bat": {
    "exec": "~/.config/waybar/script/bat.sh",
    "interval": 1,
    "return-type": "json",
    "tooltip": false,
  },
  "custom/blt": {
    "exec": "~/.config/waybar/script/blt.sh",
    "interval": 1,
    "return-type": "json",
    "on-click": "blueman-manager",
    "on-click-right": "~/.config/waybar/script/bluetooth-toggle.sh",
    "tooltip": false,
  },
  "custom/brt": {
    "exec": "~/.config/waybar/script/brt.sh",
    "interval": 1,
    "tooltip": false,
  },
  "custom/cpu": {
    "exec": "~/.config/waybar/script/cpu.sh",
    "interval": 1,
    "return-type": "json",
    "tooltip": false,
  },
  "custom/dte": {
    "exec": "~/.config/waybar/script/dte.sh",
    "interval": 1,
    "tooltip": false,
  },
  "custom/ipa": {
    "exec": "~/.config/waybar/script/ipa.sh",
    "interval": 1,
    "tooltip": false,
  },
  "custom/mda": {
    "exec": "~/.config/waybar/script/mda.sh",
    "interval": 1,
    "return-type": "json",
    "tooltip": false,
  },
  "custom/mem": {
    "exec": "~/.config/waybar/script/mem.sh",
    "interval": 1,
    "return-type": "json",
    "tooltip": false,
  },
  "custom/mic": {
    "exec": "~/.config/waybar/script/mic.sh",
    "interval": 1,
    "on-click": "pavucontrol -t 4",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "tooltip": false,
  },
  "custom/ntf": {
    "exec": "~/.config/waybar/script/ntf.sh",
    "interval": 1,
    "return-type": "json",
    "tooltip": false,
  },
  "custom/net": {
    "exec": "~/.config/waybar/script/net.sh",
    "interval": 1,
    "return-type": "json",
    "on-click": "kitty -e nmtui",
    "on-click-right": "nmcli radio wifi off",
    "tooltip": false,
  },
  "custom/ses": {
    "exec": "~/.config/waybar/script/ses.sh",
    "interval": 1,
    "tooltip": false,
  },
  "custom/str": {
    "exec": "~/.config/waybar/script/str.sh",
    "interval": 1,
    "on-click": "gnome-control-center display",
    "return-type": "json",
    "tooltip": false,
  },
  "custom/tmp": {
    "exec": "~/.config/waybar/script/tmp.sh",
    "interval": 1,
    "return-type": "json",
    "on-click": "gnome-system-monitor",
    "tooltip": false,
  },
  "custom/upl": {
    "exec": "~/.config/waybar/script/upl.sh",
    "interval": 1,
    "on-click": "gnome-system-monitor",
  },
  "custom/usr": {
    "exec": "~/.config/waybar/script/usr.sh",
    "interval": 1,
    "tooltip": false,
  },
  "custom/vol": {
    "exec": "~/.config/waybar/script/vol.sh",
    "interval": 1,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "signal": 1,
    "tooltip": false,
  },
  "custom/win": {
    "exec": "~/.config/waybar/script/win.sh",
    "return-type": "json",
    "interval": 1,
    "tooltip": false,
  },

  "group/date": {
    "orientation": "horizontal",
    "modules": ["custom/dte"],
  },
  "group/network": {
    "orientation": "horizontal",
    "modules": ["custom/net"],
  },
  "group/sound": {
    "orientation": "horizontal",
    "modules": ["custom/blt", "custom/vol", "custom/mic"],
  },
  "group/system": {
    "orientation": "horizontal",
    "modules": [
      "custom/cpu",
      "custom/mem",
      "custom/str",
      "custom/brt",
      "custom/tmp",
    ],
  },
  "group/battery": {
    "orientation": "horizontal",
    "modules": ["custom/bat"],
  },
  "group/message": {
    "orientation": "horizontal",
    "modules": ["custom/ntf"],
  },
  "group/media": {
    "orientation": "horizontal",
    "modules": ["custom/mda"],
  },

  "group/window": {
    "orientation": "horizontal",
    "modules": ["custom/win"],
  },
}
