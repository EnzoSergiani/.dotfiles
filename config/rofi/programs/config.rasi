@import "../colors.rasi"

configuration {
    show-icons:                  false;
    font:                        "DepartureMono Nerd Font Bold 11";
    case-sensitive:              false;
    matching:                    "normal";
}

* {
    border-colour:               var(foreground);
    background-colour:           var(background);
    foreground-colour:           var(foreground);
    alternate-background:        var(background-alt);
    normal-background:           var(background);
    normal-foreground:           var(foreground);
    selected-normal-background:  var(foreground);
    selected-normal-foreground:  var(background);
}

window {
    transparency:                "real";
    location:                    north;
    anchor:                      north;
    fullscreen:                  false;
    width:                       100%;
    height:                      calc(100% + 30px);
    x-offset:                    0px;
    y-offset:                    -30px;
    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    background-color:            transparent;
    background-image:            url("/home/dousai/.dotfiles/config/theme/crt-overlay.png", both);
    cursor:                      "default";
}

mainbox {
    enabled:                     true;
    spacing:                     0px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    background-color:            transparent;
    children:                    [ "menubox", "spacerbox" ];
    orientation:                 vertical;
}

menubox {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px 2px;
    padding:                     4px 12px;
    expand:                      false;
    border:                      0px solid;
    border-color:                rgba(244, 244, 244, 25%);
    border-radius:                0px 0px 3px 3px;
    background-color:            @background-colour;
    children:                    [ "prompt", "entry", "listview" ];
    orientation:                 horizontal;
}

entry {
    enabled:                     true;
    expand:                      false;
    padding:                     0px 10px;
    width:                       170px;
    border:                      1px solid;
    border-color:                rgba(244, 244, 244, 25%);
    border-radius:                3px;
    background-color:            @alternate-background;
    text-color:                  @foreground-colour;
    cursor:                      text;
    placeholder:                 "Search";
    placeholder-color:           inherit;
    vertical-align:              0.5;
}

spacerbox {
    enabled:                     true;
    expand:                      true;
    background-color:            transparent;
}

prompt {
    enabled:                     true;
    padding:                     0px 10px;
    border:                      1px solid;
    border-color:                rgba(244, 244, 244, 25%);
    border-radius:                3px;
    background-color:            @alternate-background;
    text-color:                  @foreground-colour;
    markup:                      true;
}

listview {
    enabled:                     true;
    lines:                       1;
    columns:                     14;
    cycle:                       true;
    scrollbar:                   false;
    flow:                        horizontal;
    fixed-height:                true;
    fixed-columns:               true;
    spacing:                     6px;
    margin:                      0px 0px 0px 0px;
    padding:                     0px 0px 0px 10px;
    border:                      0px 0px 0px 1px;
    border-color:                rgba(244, 244, 244, 25%);
    background-color:            transparent;
    text-color:                  @foreground-colour;
}

element {
    enabled:                     true;
    padding:                     0px 8px;
    border:                      1px solid;
    border-color:                rgba(244, 244, 244, 25%);
    border-radius:                3px;
    background-color:            transparent;
    text-color:                  @foreground-colour;
    cursor:                      pointer;
}

element normal.normal {
    background-color:            var(normal-background);
    text-color:                  var(normal-foreground);
}

element selected.normal {
    background-color:            var(selected-normal-background);
    text-color:                  var(selected-normal-foreground);
    border-color:                @foreground-colour;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}

error-message {
    padding:                     10px;
    border:                      0px solid;
    background-color:            @background-colour;
    text-color:                  @foreground-colour;
}
